; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tactical Strike"
config/description="Round-based tactical bomb-defusal FPS for Android, playable offline against bots."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
run/max_fps=60
boot_splash/bg_color=Color(0.0705882, 0.0862745, 0.101961, 1)
config/icon="res://assets/icons/icon.png"

[autoload]

Settings="*res://src/autoload/settings.gd"
GameState="*res://src/autoload/game_state.gd"
Economy="*res://src/autoload/economy.gd"
Persistence="*res://src/autoload/persistence.gd"
AudioMgr="*res://src/autoload/audio_mgr.gd"
Pools="*res://src/autoload/pools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.0705882, 0.0862745, 0.101961, 1)

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=16.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="bot"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="projectile"
3d_physics/layer_6="pickup"
3d_physics/layer_7="smoke"
3d_physics/layer_8="clip"
